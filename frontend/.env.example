# ──────────────────────────────────────────────────────────── API service ──
# Where the backend is reachable. In production this is the Railway public URL
# of the API service, with no trailing slash. The browser never sees it: every
# call is made from the Next.js server.
BACKEND_URL="http://localhost:3001"


# ─────────────────────────────────────────────────────────────── Security ──
# MUST be byte-for-byte identical to APP_SECRET on the API service. The backend
# signs session tokens with it; this service verifies them, so a mismatch means
# every sign-in appears to succeed and then every page reports "not signed in".
#
# This service never connects to the database, so it never decrypts a stored
# credential — it only reads its own tokens.
APP_SECRET="replace-with-at-least-32-random-characters"

# "true" bypasses the login screen and grants every visitor administrator
# rights. Acceptable on a laptop. Never set this on anything reachable over a
# network.
AUTH_DISABLED="false"


# ────────────────────────────────────────────── Reminders and integrations ──
# Must match ALERTS_API_KEY on the API service. Used by the scheduled reminder
# route to authenticate itself to the backend.
ALERTS_API_KEY=""

# Set this to the same value in the Vercel dashboard when using Vercel Cron.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
