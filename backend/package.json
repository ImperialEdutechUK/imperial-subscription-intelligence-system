{
  "name": "imperial-subscription-intelligence-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API service for the Imperial Edutech subscription register. Owns the database, the domain logic and every write path. Deployed to Railway.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "seed:setup": "tsx prisma/setup.ts",
    "seed:demo": "tsx prisma/seed.ts",
    "verify": "tsx scripts/verify-calculations.ts",
    "verify:writes": "tsx scripts/verify-mutations.ts",
    "verify:all": "tsx scripts/verify-calculations.ts && tsx scripts/verify-mutations.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.4",
    "next": "16.2.12",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
