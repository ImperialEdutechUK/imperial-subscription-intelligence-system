# ─────────────────────────────────────────────────────────────── Database ──
# PostgreSQL, in development as well as production.
#
# Local, via Docker:
#   docker run --name imperial-db -e POSTGRES_PASSWORD=devpass -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/postgres?schema=public"
#
# Hosted (Railway, Neon, Supabase, Azure). Copy the connection string the
# provider gives you. Check its own documentation for whether it needs
# ?sslmode=require — adding it blindly causes certificate errors on some hosts.
# DATABASE_URL="postgresql://user:password@host:5432/imperial_subs?schema=public"


# ─────────────────────────────────────────────────────────────── Security ──
# Signs session tokens AND derives the key that encrypts stored subscription
# passwords. Generate with:  openssl rand -base64 48
#
# WARNING: changing this value makes every previously stored subscription
# password permanently unreadable. There is no recovery path. See SECURITY.md.
APP_SECRET="replace-with-at-least-32-random-characters"

# "true" bypasses the login screen entirely and grants every visitor
# administrator rights, including revealing stored passwords. Acceptable on a
# laptop. Never set this on anything reachable over a network.
AUTH_DISABLED="false"


# ────────────────────────────────────────────── Reminders and integrations ──
# Shared secret for /api/alerts/digest, /api/alerts/dispatch and
# /api/calendar.ics — needed because Outlook and Power Automate cannot present
# a session cookie. Must be at least 16 characters or key-based access is
# refused rather than defaulting open. Anyone holding it can read renewal
# dates, amounts and card labels, so treat it as confidential.
ALERTS_API_KEY=""

# Power Automate flow URL for Teams reminders.
#
# NOTE: this is NOT an Office 365 "Incoming Webhook" connector URL. Microsoft
# retired those for Teams channels, so a connector URL will not work. This must
# be the HTTP POST URL produced by a Power Automate flow using the Teams
# webhook trigger, which does not require a premium licence.
# Full setup, including what could not be verified, is in POWER-AUTOMATE.md.
#
# Can also be set in the application at Settings → Reminders, which takes
# precedence over this value.
TEAMS_WEBHOOK_URL=""

# Public base URL, used for the "Open the subscription tracker" button on the
# Teams card. Falls back to the request origin if unset.
APP_URL=""

# Set automatically by Vercel Cron. If you schedule the reminder some other way,
# leave this blank and use ALERTS_API_KEY instead.
CRON_SECRET=""
